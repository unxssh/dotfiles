# ==============================================================================
# Dunst Configuration - Discord Dark Theme (Matching Waybar & Wofi)
# ==============================================================================

[global]
    ### Display & Monitor ###
    monitor = 0
    follow = none

    ### Geometry ###
    width = (280, 380)
    height = (0, 250)
    origin = top-right
    offset = (18, 58)
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 320
    progress_bar_corner_radius = 3
    progress_bar_corners = all

    ### Appearance & Borders ###
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 2
    frame_color = "#ffffff"
    gap_size = 8
    separator_color = frame
    sort = yes

    ### Text & Font ###
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "breeze-dark, Adwaita"
    icon_position = left
    min_icon_size = 28
    max_icon_size = 44
    icon_corner_radius = 8
    icon_corners = all

    ### Corners ###
    corner_radius = 14
    corners = all

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1f22"
    foreground = "#dbdee1"
    frame_color = "#404249"
    highlight = "#5865f2"
    timeout = 4

[urgency_normal]
    background = "#1e1f22"
    foreground = "#dbdee1"
    frame_color = "#ffffff"
    highlight = "#ffffff"
    timeout = 6

[urgency_critical]
    background = "#1e1f22"
    foreground = "#ffffff"
    frame_color = "#f23f43"
    highlight = "#f23f43"
    timeout = 0
